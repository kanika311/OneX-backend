PORT=5000
MONGODB_URI=mongodb+srv://...
JWT_SECRET=your-secret

# Public URL of THIS API (no /api suffix) — REQUIRED on Render for image URLs in JSON
# Local dev:
# API_PUBLIC_URL=http://localhost:5000
# Render production:
API_PUBLIC_URL=https://onex-backend-7p9r.onrender.com

# Optional: persistent upload folder (Render disk mount path)
# UPLOAD_DIR=/var/data/uploads

# Comma-separated frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Super Admin bootstrap (npm run create-admin)
SUPER_ADMIN_EMAIL=superadmin@1x-dr-ayesha.com
SUPER_ADMIN_PHONE=9876543210
SUPER_ADMIN_PASSWORD=Super@12345

# Admin panel URL for password reset links
ADMIN_PANEL_URL=http://localhost:3001

# SMTP (optional — reset link logged to console if unset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@1x-dr-ayesha.com
