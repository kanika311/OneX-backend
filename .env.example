PORT=5000
MONGODB_URI=mongodb+srv://...
JWT_SECRET=your-secret

# Public URL of THIS API (no /api suffix) — REQUIRED on Render for image URLs in JSON
# Local dev:
# API_PUBLIC_URL=http://localhost:5000
# Render production:
API_PUBLIC_URL=https://onex-backend-7p9r.onrender.com

# Optional: persistent upload folder (Render disk mount path)
# UPLOAD_DIR=/var/data/uploads

# Comma-separated frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

ADMIN_REGISTER_SECRET=your-admin-secret

# Admin panel URL (for password reset emails)
ADMIN_APP_URL=http://localhost:3001

# SMTP (required in production for forgot-password emails)
# Gmail example: use an App Password, not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="1X Admin <your-email@gmail.com>"
